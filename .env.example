# Copy this file to .env, then replace the PAT.
QODER_PAT=YOUR_QODER_PAT_HERE
QODER_PORT=8963

# This value authenticates local Agent clients to the bridge.
QODER_BRIDGE_API_KEY=local-bridge-key

# Long Qoder reasoning defaults. Values are milliseconds.
QODER_SSE_PING_INTERVAL_MS=15000
QODER_SSE_IDLE_TIMEOUT_MS=900000
QODER_SSE_REQUEST_TIMEOUT_MS=3600000

# Optional: set to 1 to reject rather than adjust unsupported Claude effort levels.
# QODER_STRICT_EFFORT=1
